# Copy to .env and fill in from your Supabase project's
# Project Settings -> Database -> Connection string.
# Never commit .env — it's gitignored.

# Transaction pooler (port 6543, pgbouncer=true). Used by Prisma Client
# (the app) at runtime — safe for serverless/edge, one connection per
# request.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432, IPv4-compatible). Used only by Prisma Migrate,
# which needs session-level features the transaction pooler doesn't
# support in transaction mode.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Set to "true" (as a string) to have `npm run vercel-build` run the seed
# script after migrations, on every build. The seed is idempotent (see
# prisma/seed-runner.ts) — safe to leave "true" permanently, since re-runs
# update existing rows instead of duplicating them. Leave unset/"false" to
# skip seeding.
SEED_ON_BUILD="false"

# Gates /admin. Generate with: npm run admin:hash-password
ADMIN_PASSWORD_HASH="salt:hash"

# Signs the /admin session cookie (HMAC-SHA256) and the /host session
# cookie. Any long random string -- e.g. `openssl rand -hex 32`. Changing
# it logs everyone out.
SESSION_SECRET="change-me"

# Canonical absolute site URL (see CLAUDE.md "Domain"). Used to build
# Stripe redirect targets (Connect onboarding return/refresh URLs) --
# Stripe requires fully-qualified https URLs, not relative paths.
NEXT_PUBLIC_SITE_URL="https://havenrush.com"

# Stripe secret key (server-only -- never expose client-side). Connect
# (Express) onboarding uses this to create connected accounts and account
# links. Get a test-mode key from the Stripe Dashboard.
STRIPE_SECRET_KEY="sk_test_..."

# Verifies POST /api/stripe/webhook's signature. From the Stripe Dashboard
# once a webhook destination is configured pointing at
# ${NEXT_PUBLIC_SITE_URL}/api/stripe/webhook (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET="whsec_..."

# Haven Rush's cut of each paid booking, in basis points (e.g. 1500 =
# 15%). See CLAUDE.md "Pricing model" -- exact number still being decided,
# so nothing hardcodes an assumption; this is the one place it's set.
PLATFORM_COMMISSION_BPS="1500"
