# Copy to .env and fill in from your Supabase project's
# Project Settings -> Database -> Connection string.
# Never commit .env — it's gitignored.

# Transaction pooler (port 6543, pgbouncer=true). Used by Prisma Client
# (the app) at runtime — safe for serverless/edge, one connection per
# request.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432, IPv4-compatible). Used only by Prisma Migrate,
# which needs session-level features the transaction pooler doesn't
# support in transaction mode.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Shared secret for POST /api/admin/seed — the one-time (safe to re-run)
# endpoint that seeds placeholder data once Vercel has the DB env vars
# above. Generate with `openssl rand -hex 32`. Leave unset to disable the
# endpoint entirely (it 501s with no secret configured).
SEED_SECRET="generate-a-long-random-value"
