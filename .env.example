# Copy to .env and fill in from your Supabase project's
# Project Settings -> Database -> Connection string.
# Never commit .env — it's gitignored.

# Transaction pooler (port 6543, pgbouncer). Used by Prisma Client (the app)
# at runtime — safe for serverless/edge, one connection per request.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432, no pooler). Used only by Prisma Migrate,
# which needs session-level features the transaction pooler doesn't support.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"
